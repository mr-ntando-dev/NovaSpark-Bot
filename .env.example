# ⚡ NovaSpark Bot v11 — Environment Variables
# Copy this file to .env and fill in your values
# (or set these as env vars in your hosting panel)

# ─── Required ───────────────────────────────────────────────────────────────
# Your WhatsApp session string (get it via: npm run pair)
SESSION_ID=NovaSpark!

# Your WhatsApp number (country code + number, no + or spaces)
OWNER_NUMBER=263786831091

# ─── Optional ────────────────────────────────────────────────────────────────
# Bot display name
BOT_NAME=NovaSpark Bot

# Command prefix (default: .)
PREFIX=.

# Session folder name
SESSION_DIR=session

# ─── Render Auto-Persist (optional but highly recommended) ───────────────────
# Set these so that after pairing, SESSION_ID is automatically saved to your
# Render service env vars — meaning the bot survives restarts with zero manual steps.
#
# RENDER_API_KEY: Get from https://dashboard.render.com/u/settings → API Keys
# RENDER_SERVICE_ID: Get from your service URL — it looks like srv-xxxxxxxxxxxx
#
# RENDER_API_KEY=rnd_xxxxxxxxxxxxxxxxxxxx
# RENDER_SERVICE_ID=srv-xxxxxxxxxxxxxxxxxxxx
# Or set PAIRING_NUMBER to get a code printed in the console:
# PAIRING_NUMBER=263786831091

# Web pairing server port (default: 3001)
# PAIR_PORT=3001

# ─── API Keys (all optional — bot works without them) ────────────────────────
# OPENAI_API_KEY=sk-...          # GPT commands
# DEEPAI_API_KEY=...             # Image generation
# REMOVE_BG_API_KEY=...          # Background removal
# GIPHY_API_KEY=...              # GIF search
# YOUTUBE_API_KEY=...            # YouTube search
# NEWS_API_KEY=...               # News headlines
# WEATHER_API_KEY=...            # Weather (WeatherAPI.com)

# ─── Branding ────────────────────────────────────────────────────────────────
# CHANNEL_LINK=https://whatsapp.com/channel/...

# ─── Misc ────────────────────────────────────────────────────────────────────
# Timezone for scheduled features (default: Africa/Harare)
# TZ=Africa/Harare
